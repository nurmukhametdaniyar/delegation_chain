/target
**/target
scripts/.venv/
__pycache__/
.DS_Store
# M8 dry-run output: its numbers are never reported (SPEC §15).
results/dry-run/
fuzz/corpus-work/
fuzz/artifacts/
# Raw benchmark data stays out of git: the archives are kept by the author,
# and archive/MANIFEST.sha256 (committed) pins them (frozen plan §5).
results/raw/
results/archive/*.zst
results/criterion/
# Local copies of measured raw data (frozen plan §5); never committed.
backups/
# Measured data of aborted run processes, set aside before their redo (D-76).
results/aborted/
# The exploratory phase breakdown (D-77): raw data and archives stay out of
# git like M9's; env.json and archive/MANIFEST.sha256 are committed.
results/exploratory/phases/raw/
results/exploratory/phases/archive/*.zst
results/exploratory/phases/aborted/
# AIP's own benchmark run here (D-79): the same rule.
results/exploratory/aip/raw/
results/exploratory/aip/archive/*.zst
results/exploratory/aip/aborted/
