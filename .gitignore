# committed as criterion.tar.zst; results/criterion/ is where it unpacks.
results/raw/
results/criterion/
# Local copies of measured raw data (frozen plan §5); never committed.
backups/
# Measured data of aborted run processes, set aside before their redo (D-76).
results/aborted/
# The exploratory phase breakdown (D-77): raw CSVs stay out of git like
# M9's; the archives, their manifest and env.json are committed (D-89).
results/exploratory/phases/raw/
results/exploratory/phases/aborted/
# AIP's own benchmark run here (D-79): the same rule.
results/exploratory/aip/raw/
results/exploratory/aip/aborted/
# The encoding-check benchmark (D-87): the same rule.
results/exploratory/encoding/raw/
results/exploratory/encoding/aborted/
# A packed deposit (ARTIFACT.md §6): uploaded, never committed.
deposit/
